[flake8]
# E501 (line length) and E701 (multiple statements) were already ignored in the
# old tox config. E203/W503 conflict with black's formatting (black owns slice
# whitespace and line-break-before-operator), so they are disabled per black's
# own guidance.
extend-ignore = E203, E501, E701, W503
max-line-length = 88
exclude =
    .git,
    .venv,
    __pycache__,
    build,
    dist
